# 最小化配置：首次启动会进入安装向导，并把运行时配置保存到 DATA_DIR/app-config.json。
APP_ADDR=:8080
DATA_DIR=/app/data

# 反向代理/HTTPS 部署时再调整：
TRUST_PROXY=false
COOKIE_SECURE=true

# Hosted setup remains protected. VibeNest can generate this internal password
# separately for each project; retrieve it from Settings > Environment > Reveal.
# For local use, supply your own unique password (at least 24 characters).
VIBENEST_PILOT=true
SETUP_BOOTSTRAP_USER=operator
SETUP_BOOTSTRAP_PASSWORD=

# VibeNest's Compose path supplies the project's HTTPS origin as APP_URL.
# APP_BASE_URL, when explicitly configured, continues to take precedence.
APP_URL=

# 可选。留空会自动生成并持久化；生产建议首次部署后不要随意更换。
APP_SECRET=

SESSION_TTL_HOURS=87600
UPLOAD_MAX_MB=8

# Optional GitHub OAuth login.
# Callback URL: https://your-domain.example/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
